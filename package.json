{
    "name": "let-them-eat-tokens",
    "private": true,
    "type": "module",
    "description": "The court gazette of artificial intelligence: AI CEOs ranked by the pitchforks their own words raised.",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "tsc",
        "start": "node dist/index.js",
        "db:migrate": "prisma migrate dev",
        "db:deploy": "prisma migrate deploy",
        "db:generate": "prisma generate",
        "db:studio": "prisma studio",
        "test:unit": "vitest run --project unit",
        "test:e2e": "bash scripts/test-e2e.sh",
        "bootstrap": "bash scripts/bootstrap.sh",
        "clean": "bash scripts/clean.sh",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "check": "tsx scripts/check.ts",
        "check:sources": "tsx scripts/check.ts --fetch",
        "scout": "node dist/scout.js",
        "seed:min": "node dist/seed.js",
        "seed:dev": "tsx scripts/seed-dev.ts"
    },
    "dependencies": {
        "@fontsource/barlow-condensed": "5.3.0",
        "@fontsource/inter": "5.3.0",
        "@lindeneg/cl-env": "0.1.3",
        "@prisma/adapter-better-sqlite3": "7.10.1",
        "@prisma/client": "7.10.1",
        "@resvg/resvg-js": "2.6.2",
        "bcrypt": "6.0.0",
        "compression": "1.8.2",
        "cookie-parser": "1.4.7",
        "express": "5.3.0",
        "express-rate-limit": "8.7.0",
        "helmet": "8.3.0",
        "jsonwebtoken": "9.0.3",
        "multer": "2.5.0",
        "pino": "10.3.1",
        "pino-http": "11.0.0",
        "pino-pretty": "13.1.3",
        "satori": "0.59.2",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@types/bcrypt": "6.0.0",
        "@types/compression": "1.8.1",
        "@types/cookie-parser": "1.4.10",
        "@types/express": "5.0.6",
        "@types/jsonwebtoken": "9.0.10",
        "@types/multer": "2.3.0",
        "@types/node": "24.13.6",
        "jsdom": "30.1.1",
        "playwright": "1.64.1",
        "prettier": "3.9.9",
        "prisma": "7.10.1",
        "tsx": "4.23.15",
        "typescript": "7.0.2",
        "vite": "8.3.5",
        "vitest": "5.0.5"
    },
    "allowScripts": {
        "better-sqlite3@12.11.1": true,
        "bcrypt@6.0.0": true,
        "prisma@7.10.1": true,
        "@prisma/engines@7.10.1": true,
        "esbuild@0.28.2": true
    },
    "overrides": {
        "fflate": "0.7.5"
    }
}
